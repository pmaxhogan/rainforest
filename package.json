{
  "name": "rainforest",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/worker",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ascii": "node scripts/check-ascii.mjs",
    "test": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run ascii && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tar": "^7.5.23",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
